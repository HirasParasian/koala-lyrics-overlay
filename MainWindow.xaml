<Window x:Class="SpotifyLyricsOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="700"
        Height="180"
        MinWidth="280"
        MinHeight="80"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        Icon="pack://application:,,,/icon/AppIcon.ico"
        Title="Spotify Lyrics Overlay">

    <Window.Resources>
        <Style x:Key="HoverOnly" TargetType="{x:Type FrameworkElement}">
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=RootPanel}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="Chrome"
                            CaptionHeight="0"
                            CornerRadius="14"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootPanel"
            CornerRadius="14"
            Padding="14,8,14,8"
            MouseLeftButtonDown="DragWindow">
        <Border.Style>
            <Style TargetType="{x:Type Border}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#EE111111"/>
                        <Setter Property="BorderBrush" Value="#55444444"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Top Controls (Font, Color, Lyrics Folder & Position Lock) -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,0,0,2"
                        Style="{StaticResource HoverOnly}">
                <!-- Font Family Selector -->
                <ComboBox x:Name="FontFamilyComboBox"
                          Width="130"
                          Height="24"
                          FontSize="11"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"
                          ToolTip="Pilih Jenis Font"
                          SelectionChanged="FontFamilyComboBox_SelectionChanged"/>

                <!-- Font Size Slider -->
                <TextBlock Text="Size"
                           Foreground="#777777"
                           FontSize="11"
                           Margin="0,0,4,0"
                           VerticalAlignment="Center"/>
                <Slider x:Name="FontSizeSlider"
                        Width="80"
                        Minimum="16"
                        Maximum="72"
                        Value="36"
                        TickFrequency="2"
                        IsSnapToTickEnabled="True"
                        VerticalAlignment="Center"
                        ValueChanged="FontSizeSlider_ValueChanged"/>

                <!-- Color Palette Button & Popup -->
                <Button x:Name="ColorPaletteButton"
                        Content="&#xE790;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="13"
                        Width="28"
                        Height="24"
                        Padding="0"
                        Margin="6,0,0,0"
                        ToolTip="Pilih Warna Lirik"
                        Click="ColorPaletteButton_Click"/>

                <Popup x:Name="ColorPalettePopup"
                       PlacementTarget="{Binding ElementName=ColorPaletteButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Background="#F0181818"
                            BorderBrush="#444444"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,6"
                            Margin="0,4,0,0">
                        <WrapPanel Width="150" HorizontalAlignment="Center">
                            <!-- Color Swatches -->
                            <Button Style="{x:Null}" Width="24" Height="24" Margin="3" Cursor="Hand" Background="#1ED760" BorderBrush="#88FFFFFF" BorderThickness="1" ToolTip="Spotify Green" Tag="#1ED760" Click="ColorSwatch_Click">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"/></ControlTemplate></Button.Template>
                            </Button>
                            <Button Style="{x:Null}" Width="24" Height="24" Margin="3" Cursor="Hand" Background="#FFFFFF" BorderBrush="#88FFFFFF" BorderThickness="1" ToolTip="Pure White" Tag="#FFFFFF" Click="ColorSwatch_Click">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"/></ControlTemplate></Button.Template>
                            </Button>
                            <Button Style="{x:Null}" Width="24" Height="24" Margin="3" Cursor="Hand" Background="#00F2FE" BorderBrush="#88FFFFFF" BorderThickness="1" ToolTip="Electric Cyan" Tag="#00F2FE" Click="ColorSwatch_Click">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"/></ControlTemplate></Button.Template>
                            </Button>
                            <Button Style="{x:Null}" Width="24" Height="24" Margin="3" Cursor="Hand" Background="#FFD166" BorderBrush="#88FFFFFF" BorderThickness="1" ToolTip="Golden Yellow" Tag="#FFD166" Click="ColorSwatch_Click">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"/></ControlTemplate></Button.Template>
                            </Button>
                            <Button Style="{x:Null}" Width="24" Height="24" Margin="3" Cursor="Hand" Background="#FF758C" BorderBrush="#88FFFFFF" BorderThickness="1" ToolTip="Pastel Rose" Tag="#FF758C" Click="ColorSwatch_Click">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"/></ControlTemplate></Button.Template>
                            </Button>
                            <Button Style="{x:Null}" Width="24" Height="24" Margin="3" Cursor="Hand" Background="#FF5858" BorderBrush="#88FFFFFF" BorderThickness="1" ToolTip="Coral Red" Tag="#FF5858" Click="ColorSwatch_Click">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"/></ControlTemplate></Button.Template>
                            </Button>
                            <Button Style="{x:Null}" Width="24" Height="24" Margin="3" Cursor="Hand" Background="#B388FF" BorderBrush="#88FFFFFF" BorderThickness="1" ToolTip="Lavender Purple" Tag="#B388FF" Click="ColorSwatch_Click">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"/></ControlTemplate></Button.Template>
                            </Button>
                            <Button Style="{x:Null}" Width="24" Height="24" Margin="3" Cursor="Hand" Background="#A8FF78" BorderBrush="#88FFFFFF" BorderThickness="1" ToolTip="Neon Mint" Tag="#A8FF78" Click="ColorSwatch_Click">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"/></ControlTemplate></Button.Template>
                            </Button>
                        </WrapPanel>
                    </Border>
                </Popup>

                <!-- Open Lyrics Folder Button -->
                <Button x:Name="OpenLyricsFolderButton"
                        Content="&#xED25;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="13"
                        Width="28"
                        Height="24"
                        Padding="0"
                        Margin="6,0,0,0"
                        ToolTip="Buka Folder Lirik (Offline / Custom Lyrics)"
                        Click="OpenLyricsFolderButton_Click"/>

                <!-- Position Lock Button -->
                <Button x:Name="PositionLockButton"
                        Content="&#xE72E;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="13"
                        Width="28"
                        Height="24"
                        Padding="0"
                        Margin="6,0,0,0"
                        ToolTip="Lock position"
                        Click="PositionLockButton_Click"/>
            </StackPanel>

            <!-- Row 1: Lyrics Display -->
            <StackPanel x:Name="SyncedLyricsPanel"
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        Margin="0,2,0,2">

                <Grid HorizontalAlignment="Center">
                    <TextBlock x:Name="CurrentLyricStrokeLeft"
                               Foreground="#D9000000"
                               FontSize="36"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TranslateTransform X="-1.5"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="CurrentLyricStrokeRight"
                               Foreground="#D9000000"
                               FontSize="36"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TranslateTransform X="1.5"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="CurrentLyricStrokeTop"
                               Foreground="#D9000000"
                               FontSize="36"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TranslateTransform Y="-1.5"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="CurrentLyricStrokeBottom"
                               Foreground="#D9000000"
                               FontSize="36"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TranslateTransform Y="1.5"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="CurrentLyric"
                               Foreground="#1ED760"
                               FontSize="36"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                </Grid>

                <Grid HorizontalAlignment="Center"
                      Margin="0,6,0,0">
                    <TextBlock x:Name="NextLyricStrokeLeft"
                               Foreground="#C9000000"
                               FontSize="18"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <TranslateTransform X="-1"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="NextLyricStrokeRight"
                               Foreground="#C9000000"
                               FontSize="18"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <TranslateTransform X="1"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="NextLyricStrokeTop"
                               Foreground="#C9000000"
                               FontSize="18"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <TranslateTransform Y="-1"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="NextLyricStrokeBottom"
                               Foreground="#C9000000"
                               FontSize="18"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <TranslateTransform Y="1"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="NextLyric"
                               Foreground="#FFD166"
                               FontSize="18"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <!-- Row 1: Plain Lyrics Display (full text, scrollable) -->
            <ScrollViewer x:Name="PlainLyricsScroller"
                          Grid.Row="1"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          Margin="0,2,0,2"
                          Padding="4,0">
                <Grid>
                    <TextBlock x:Name="PlainLyricsStroke"
                               Foreground="#D9000000"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               LineHeight="30"
                               HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <BlurEffect Radius="2" KernelType="Gaussian"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="PlainLyricsText"
                               Foreground="#1ED760"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               LineHeight="30"
                               HorizontalAlignment="Center"/>
                </Grid>
            </ScrollViewer>

            <!-- Row 2: Bottom Bar (Song Title & Resize Grip) -->
            <Grid Grid.Row="2"
                  Margin="0,4,0,0">
                <TextBlock x:Name="TrackText"
                           Foreground="#999999"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="24,0,24,0"
                           Style="{StaticResource HoverOnly}"/>

                <ResizeGrip x:Name="WindowResizeGrip"
                            Width="14"
                            Height="14"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,-8,-4"
                            Style="{StaticResource HoverOnly}"/>
            </Grid>

            <!-- Keep StatusText collapsed to satisfy code-behind without displaying -->
            <TextBlock x:Name="StatusText" Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
