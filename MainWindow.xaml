<Window x:Class="SpotifyLyricsOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="700"
        Height="180"
        MinWidth="280"
        MinHeight="80"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        Icon="icon/AppIcon.ico"
        Title="Spotify Lyrics Overlay">

    <Window.Resources>
        <Style x:Key="HoverOnly" TargetType="{x:Type FrameworkElement}">
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=RootPanel}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="Chrome"
                            CaptionHeight="0"
                            CornerRadius="14"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootPanel"
            CornerRadius="14"
            Padding="14,8,14,8"
            MouseLeftButtonDown="DragWindow">
        <Border.Style>
            <Style TargetType="{x:Type Border}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#EE111111"/>
                        <Setter Property="BorderBrush" Value="#55444444"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Top Controls (Font Size & Position Lock) -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,0,0,2"
                        Style="{StaticResource HoverOnly}">
                <TextBlock Text="Font"
                           Foreground="#777777"
                           FontSize="12"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"/>
                <Slider x:Name="FontSizeSlider"
                        Width="100"
                        Minimum="16"
                        Maximum="72"
                        Value="36"
                        TickFrequency="2"
                        IsSnapToTickEnabled="True"
                        VerticalAlignment="Center"
                        ValueChanged="FontSizeSlider_ValueChanged"/>
                <Button x:Name="PositionLockButton"
                        Content="&#xE72E;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="13"
                        Width="28"
                        Height="24"
                        Padding="0"
                        Margin="8,0,0,0"
                        ToolTip="Lock position"
                        Click="PositionLockButton_Click"/>
            </StackPanel>

            <!-- Row 1: Lyrics Display -->
            <StackPanel x:Name="SyncedLyricsPanel"
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        Margin="0,2,0,2">

                <Grid HorizontalAlignment="Center">
                    <TextBlock x:Name="CurrentLyricStrokeLeft"
                               Foreground="#D9000000"
                               FontSize="36"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TranslateTransform X="-1.5"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="CurrentLyricStrokeRight"
                               Foreground="#D9000000"
                               FontSize="36"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TranslateTransform X="1.5"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="CurrentLyricStrokeTop"
                               Foreground="#D9000000"
                               FontSize="36"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TranslateTransform Y="-1.5"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="CurrentLyricStrokeBottom"
                               Foreground="#D9000000"
                               FontSize="36"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TranslateTransform Y="1.5"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="CurrentLyric"
                               Foreground="#1ED760"
                               FontSize="36"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                </Grid>

                <Grid HorizontalAlignment="Center"
                      Margin="0,6,0,0">
                    <TextBlock x:Name="NextLyricStrokeLeft"
                               Foreground="#C9000000"
                               FontSize="18"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <TranslateTransform X="-1"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="NextLyricStrokeRight"
                               Foreground="#C9000000"
                               FontSize="18"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <TranslateTransform X="1"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="NextLyricStrokeTop"
                               Foreground="#C9000000"
                               FontSize="18"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <TranslateTransform Y="-1"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="NextLyricStrokeBottom"
                               Foreground="#C9000000"
                               FontSize="18"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <TranslateTransform Y="1"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="NextLyric"
                               Foreground="#FFD166"
                               FontSize="18"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <!-- Row 1: Plain Lyrics Display (full text, scrollable) -->
            <ScrollViewer x:Name="PlainLyricsScroller"
                          Grid.Row="1"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,2,0,2"
                          Padding="4,0">
                <Grid>
                    <TextBlock x:Name="PlainLyricsStroke"
                               Foreground="#D9000000"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               LineHeight="30"
                               HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <BlurEffect Radius="2" KernelType="Gaussian"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="PlainLyricsText"
                               Foreground="#1ED760"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               LineHeight="30"
                               HorizontalAlignment="Center"/>
                </Grid>
            </ScrollViewer>

            <!-- Row 2: Bottom Bar (Song Title & Resize Grip) -->
            <Grid Grid.Row="2"
                  Margin="0,4,0,0">
                <TextBlock x:Name="TrackText"
                           Foreground="#999999"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="24,0,24,0"
                           Style="{StaticResource HoverOnly}"/>

                <ResizeGrip x:Name="WindowResizeGrip"
                            Width="14"
                            Height="14"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,-8,-4"
                            Style="{StaticResource HoverOnly}"/>
            </Grid>

            <!-- Keep StatusText collapsed to satisfy code-behind without displaying -->
            <TextBlock x:Name="StatusText" Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
